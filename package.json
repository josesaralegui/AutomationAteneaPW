    },
    "homepage": "https://github.com/Atenea-Conocimientos/AteneaConocimientos-PW#readme",
    "description": "",
    "devDependencies": {
        "@babel/eslint-parser": "^7.28.6",
        "@babel/preset-env": "^7.29.0",
        "@eslint/js": "^9.38.0",
        "@playwright/test": "^1.56.0",
        "@types/node": "^24.7.2",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "concurrently": "^9.2.1",
        "dotenv": "^17.2.4",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "typescript-eslint": "^8.56.0"
    },
    "scripts": {
        "test": "playwright test",
        "test:qa": "TEST_ENV=qa npx playwright test",
        "test:smoke": "playwright test --grep \"@smoke\" ",
        "test:headed": "playwright test --headed",
        "test:ci": "playwright test --reporter=line",
        "report:open": "playwright show-report",
        "trace:view": "npx playwright show-trace trace.zip",
        "typecheck": "tsc --noEmit",
        "lint": "eslint tests pages utils playwright.config.ts --ext .ts",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier \"**/*.{ts,js,json,md}\" --write",
        "format:check": "npm run format -- --check",
        "prepare": "husky",
        "dashboard:server": "node dashboard-server.js",
        "dashboard:ui": "cd dashboard-ui && npm start",
        "dashboard": "concurrently \"npm run dashboard:server\" \"npm run dashboard:ui\""
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1"
    }
}
